# MS SQL Server Configuration
MSSQL_SA_PASSWORD=YourStrong@Password123

# Spring Boot Application Configuration
SPRING_DATASOURCE_URL=jdbc:sqlserver://mssql:1433;databaseName=SensitiveWordsDB;encrypt=false;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=YourStrong@Password123
SPRING_JPA_HIBERNATE_DDL_AUTO=create

# JWT Configuration
JWT_SECRET=my-secret-key-for-jwt-token-generation-min-256-bits
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8080

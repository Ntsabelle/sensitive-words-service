{
  "openapi": "3.0.1",
  "info": {
    "title": "Sensitive Words Service",
    "version": "0.0.1-SNAPSHOT"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/v1/sensitive-words": {
      "get": {
        "tags": ["Sensitive Word Controller"],
        "summary": "Get all sensitive words",
        "operationId": "getAllSensitiveWords",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (0-indexed)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Page size",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of sensitive words",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SensitiveWord"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Sensitive Word Controller"],
        "summary": "Create a new sensitive word",
        "operationId": "createSensitiveWord",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSensitiveWordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Sensitive word created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SensitiveWord"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sensitive-words/{id}": {
      "get": {
        "tags": ["Sensitive Word Controller"],
        "summary": "Get sensitive word by ID",
        "operationId": "getSensitiveWordById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sensitive word found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SensitiveWord"
                }
              }
            }
          },
          "404": {
            "description": "Sensitive word not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Sensitive Word Controller"],
        "summary": "Update a sensitive word",
        "operationId": "updateSensitiveWord",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSensitiveWordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sensitive word updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SensitiveWord"
                }
              }
            }
          },
          "404": {
            "description": "Sensitive word not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Sensitive Word Controller"],
        "summary": "Delete a sensitive word",
        "operationId": "deleteSensitiveWord",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Sensitive word deleted successfully"
          },
          "404": {
            "description": "Sensitive word not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sanitize": {
      "post": {
        "tags": ["Sanitize Controller"],
        "summary": "Sanitize text by replacing sensitive words",
        "operationId": "sanitizeText",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SanitizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Text sanitized successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SanitizeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SensitiveWord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "word": {
            "type": "string",
            "example": "badword"
          },
          "category": {
            "type": "string",
            "example": "profanity"
          },
          "severity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"],
            "example": "HIGH"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateSensitiveWordRequest": {
        "type": "object",
        "required": ["word", "category", "severity"],
        "properties": {
          "word": {
            "type": "string",
            "example": "badword",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "example": "profanity",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"],
            "example": "HIGH"
          }
        }
      },
      "UpdateSensitiveWordRequest": {
        "type": "object",
        "properties": {
          "word": {
            "type": "string",
            "example": "badword"
          },
          "category": {
            "type": "string",
            "example": "profanity"
          },
          "severity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"],
            "example": "HIGH"
          }
        }
      },
      "SanitizeRequest": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {
            "type": "string",
            "example": "This is a badword text"
          }
        }
      },
      "SanitizeResponse": {
        "type": "object",
        "properties": {
          "sanitizedText": {
            "type": "string",
            "example": "This is a ******* text"
          },
          "matchCount": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    }
  }
}
